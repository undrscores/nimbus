// Generated by `nimbus` from the wallpaper scheme; do not edit.
layout {
    focus-ring {
        active-color "#{{primary}}"
        inactive-color "#{{outlineVariant}}"
        urgent-color "#{{error}}"
    }
    border {
        active-color "#{{primary}}"
        inactive-color "#{{outlineVariant}}"
        urgent-color "#{{error}}"
    }
    insert-hint {
        color "#{{primary}}80"
    }
}
