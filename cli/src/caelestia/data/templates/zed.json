{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Caelestia",
  "author": "caelestia (generated from the wallpaper)",
  "themes": [
    {
      "name": "Caelestia",
      "appearance": "{{appearance}}",
      "style": {
        "background.appearance": "transparent",
        "border": "#{{outlineVariant}}",
        "border.variant": "#{{outlineVariant}}",
        "border.focused": "#{{primary}}",
        "border.selected": "#{{primary}}",
        "border.transparent": "#00000000",
        "border.disabled": "#{{outlineVariant}}",
        "elevated_surface.background": "#{{surfaceContainerHigh}}",
        "surface.background": "#{{surfaceContainer}}{{opacity_hex}}",
        "background": "#{{surface}}{{opacity_hex}}",
        "element.background": "#{{surfaceContainerHigh}}",
        "element.hover": "#{{surfaceContainerHighest}}",
        "element.active": "#{{secondaryContainer}}",
        "element.selected": "#{{secondaryContainer}}",
        "element.disabled": "#{{surfaceContainer}}",
        "drop_target.background": "#{{primary}}40",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#{{surfaceContainerHigh}}",
        "ghost_element.active": "#{{secondaryContainer}}",
        "ghost_element.selected": "#{{secondaryContainer}}",
        "ghost_element.disabled": "#{{surfaceContainer}}",
        "text": "#{{onSurface}}",
        "text.muted": "#{{onSurfaceVariant}}",
        "text.placeholder": "#{{outline}}",
        "text.disabled": "#{{outline}}",
        "text.accent": "#{{primary}}",
        "icon": "#{{onSurface}}",
        "icon.muted": "#{{onSurfaceVariant}}",
        "icon.disabled": "#{{outline}}",
        "icon.placeholder": "#{{outline}}",
        "icon.accent": "#{{primary}}",
        "status_bar.background": "#{{surfaceContainer}}{{opacity_hex}}",
        "title_bar.background": "#{{surfaceContainer}}{{opacity_hex}}",
        "title_bar.inactive_background": "#{{surface}}{{opacity_hex}}",
        "toolbar.background": "#{{surfaceContainerLowest}}{{opacity_hex}}",
        "tab_bar.background": "#{{surfaceContainer}}{{opacity_hex}}",
        "tab.inactive_background": "#{{surfaceContainer}}{{opacity_hex}}",
        "tab.active_background": "#{{surfaceContainerLowest}}{{opacity_hex}}",
        "search.match_background": "#{{primary}}40",
        "panel.background": "#{{surfaceContainer}}{{opacity_hex}}",
        "panel.focused_border": "#{{primary}}",
        "pane.focused_border": null,
        "scrollbar.thumb.background": "#{{outline}}60",
        "scrollbar.thumb.hover_background": "#{{outline}}90",
        "scrollbar.thumb.border": "#{{outline}}60",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#{{outlineVariant}}",
        "editor.foreground": "#{{onSurface}}",
        "editor.background": "#{{surfaceContainerLowest}}{{opacity_hex}}",
        "editor.gutter.background": "#{{surfaceContainerLowest}}{{opacity_hex}}",
        "editor.subheader.background": "#{{surfaceContainer}}",
        "editor.active_line.background": "#{{surfaceContainerLow}}",
        "editor.highlighted_line.background": "#{{surfaceContainerLow}}",
        "editor.line_number": "#{{outline}}",
        "editor.active_line_number": "#{{onSurface}}",
        "editor.invisible": "#{{outlineVariant}}",
        "editor.wrap_guide": "#{{outlineVariant}}",
        "editor.active_wrap_guide": "#{{outline}}",
        "editor.document_highlight.read_background": "#{{primary}}25",
        "editor.document_highlight.write_background": "#{{primary}}40",
        "terminal.background": "#{{background}}{{opacity_hex}}",
        "terminal.foreground": "#{{onSurface}}",
        "terminal.bright_foreground": "#{{onSurface}}",
        "terminal.dim_foreground": "#{{onSurfaceVariant}}",
        "terminal.ansi.black": "#{{term0}}",
        "terminal.ansi.red": "#{{term1}}",
        "terminal.ansi.green": "#{{term2}}",
        "terminal.ansi.yellow": "#{{term3}}",
        "terminal.ansi.blue": "#{{term4}}",
        "terminal.ansi.magenta": "#{{term5}}",
        "terminal.ansi.cyan": "#{{term6}}",
        "terminal.ansi.white": "#{{term7}}",
        "terminal.ansi.bright_black": "#{{term8}}",
        "terminal.ansi.bright_red": "#{{term9}}",
        "terminal.ansi.bright_green": "#{{term10}}",
        "terminal.ansi.bright_yellow": "#{{term11}}",
        "terminal.ansi.bright_blue": "#{{term12}}",
        "terminal.ansi.bright_magenta": "#{{term13}}",
        "terminal.ansi.bright_cyan": "#{{term14}}",
        "terminal.ansi.bright_white": "#{{term15}}",
        "link_text.hover": "#{{klink}}",
        "conflict": "#{{yellow}}",
        "conflict.background": "#{{yellow}}20",
        "conflict.border": "#{{yellow}}",
        "created": "#{{green}}",
        "created.background": "#{{green}}20",
        "created.border": "#{{green}}",
        "deleted": "#{{red}}",
        "deleted.background": "#{{red}}20",
        "deleted.border": "#{{red}}",
        "error": "#{{error}}",
        "error.background": "#{{errorContainer}}",
        "error.border": "#{{error}}",
        "hidden": "#{{outline}}",
        "hint": "#{{outline}}",
        "hint.background": "#{{surfaceContainerHigh}}",
        "hint.border": "#{{outlineVariant}}",
        "ignored": "#{{outline}}",
        "info": "#{{blue}}",
        "info.background": "#{{blue}}20",
        "info.border": "#{{blue}}",
        "modified": "#{{yellow}}",
        "modified.background": "#{{yellow}}20",
        "modified.border": "#{{yellow}}",
        "predictive": "#{{outline}}",
        "renamed": "#{{blue}}",
        "renamed.background": "#{{blue}}20",
        "renamed.border": "#{{blue}}",
        "success": "#{{success}}",
        "success.background": "#{{successContainer}}",
        "success.border": "#{{success}}",
        "unreachable": "#{{outline}}",
        "unreachable.background": "#{{surfaceContainer}}",
        "unreachable.border": "#{{outlineVariant}}",
        "warning": "#{{yellow}}",
        "warning.background": "#{{yellow}}20",
        "warning.border": "#{{yellow}}",
        "players": [
          { "cursor": "#{{primary}}", "background": "#{{primary}}", "selection": "#{{primary}}40" },
          { "cursor": "#{{tertiary}}", "background": "#{{tertiary}}", "selection": "#{{tertiary}}40" },
          { "cursor": "#{{secondary}}", "background": "#{{secondary}}", "selection": "#{{secondary}}40" },
          { "cursor": "#{{green}}", "background": "#{{green}}", "selection": "#{{green}}40" },
          { "cursor": "#{{peach}}", "background": "#{{peach}}", "selection": "#{{peach}}40" },
          { "cursor": "#{{pink}}", "background": "#{{pink}}", "selection": "#{{pink}}40" }
        ],
        "syntax": {
          "attribute": { "color": "#{{yellow}}" },
          "boolean": { "color": "#{{peach}}" },
          "comment": { "color": "#{{outline}}", "font_style": "italic" },
          "comment.doc": { "color": "#{{onSurfaceVariant}}", "font_style": "italic" },
          "constant": { "color": "#{{peach}}" },
          "constructor": { "color": "#{{sapphire}}" },
          "embedded": { "color": "#{{onSurface}}" },
          "emphasis": { "color": "#{{primary}}", "font_style": "italic" },
          "emphasis.strong": { "color": "#{{primary}}", "font_weight": 700 },
          "enum": { "color": "#{{yellow}}" },
          "function": { "color": "#{{blue}}" },
          "hint": { "color": "#{{outline}}" },
          "keyword": { "color": "#{{mauve}}" },
          "label": { "color": "#{{primary}}" },
          "link_text": { "color": "#{{klink}}", "font_style": "italic" },
          "link_uri": { "color": "#{{klink}}" },
          "number": { "color": "#{{peach}}" },
          "operator": { "color": "#{{sky}}" },
          "predictive": { "color": "#{{outline}}", "font_style": "italic" },
          "preproc": { "color": "#{{mauve}}" },
          "primary": { "color": "#{{onSurface}}" },
          "property": { "color": "#{{lavender}}" },
          "punctuation": { "color": "#{{onSurfaceVariant}}" },
          "punctuation.bracket": { "color": "#{{onSurfaceVariant}}" },
          "punctuation.delimiter": { "color": "#{{onSurfaceVariant}}" },
          "punctuation.list_marker": { "color": "#{{primary}}" },
          "punctuation.special": { "color": "#{{pink}}" },
          "string": { "color": "#{{green}}" },
          "string.escape": { "color": "#{{pink}}" },
          "string.regex": { "color": "#{{pink}}" },
          "string.special": { "color": "#{{pink}}" },
          "string.special.symbol": { "color": "#{{pink}}" },
          "tag": { "color": "#{{blue}}" },
          "text.literal": { "color": "#{{green}}" },
          "title": { "color": "#{{primary}}", "font_weight": 700 },
          "type": { "color": "#{{yellow}}" },
          "variable": { "color": "#{{onSurface}}" },
          "variable.special": { "color": "#{{red}}" },
          "variant": { "color": "#{{sapphire}}" }
        }
      }
    }
  ]
}
