// Nimbus: snippets for ~/.config/niri/config.kdl
// Replace /path/to/nimbus with your checkout (for example /home/you/Projects/nimbus).

// Start the shell (and stop starting waybar or any other bar).
spawn-at-startup "/path/to/nimbus/scripts/niri-start.sh"

binds {
    Mod+Space        hotkey-overlay-title="Nimbus: launcher"          { spawn "qs" "-p" "/path/to/nimbus/shell.qml" "ipc" "call" "shortcut" "trigger" "launcher"; }
    Mod+A            hotkey-overlay-title="Nimbus: dashboard"         { spawn "qs" "-p" "/path/to/nimbus/shell.qml" "ipc" "call" "shortcut" "trigger" "dashboard"; }
    Mod+N            hotkey-overlay-title="Nimbus: sidebar"           { spawn "qs" "-p" "/path/to/nimbus/shell.qml" "ipc" "call" "shortcut" "trigger" "sidebar"; }
    Mod+X            hotkey-overlay-title="Nimbus: session menu"      { spawn "qs" "-p" "/path/to/nimbus/shell.qml" "ipc" "call" "shortcut" "trigger" "session"; }
    Mod+Y            hotkey-overlay-title="Nimbus: utilities"         { spawn "qs" "-p" "/path/to/nimbus/shell.qml" "ipc" "call" "shortcut" "trigger" "utilities"; }
    Mod+S            hotkey-overlay-title="Nimbus: settings (toggle)" { spawn "qs" "-p" "/path/to/nimbus/shell.qml" "ipc" "call" "shortcut" "trigger" "nexus"; }
    Mod+Ctrl+Comma   hotkey-overlay-title="Nimbus: settings"          { spawn "qs" "-p" "/path/to/nimbus/shell.qml" "ipc" "call" "shortcut" "trigger" "nexus"; }
    Mod+Shift+D      hotkey-overlay-title="Nimbus: do not disturb"    { spawn "qs" "-p" "/path/to/nimbus/shell.qml" "ipc" "call" "shortcut" "trigger" "toggleDnd"; }
    Mod+Ctrl+N       hotkey-overlay-title="Nimbus: clear notifications" { spawn "qs" "-p" "/path/to/nimbus/shell.qml" "ipc" "call" "shortcut" "trigger" "clearNotifs"; }
    Mod+Shift+S      hotkey-overlay-title="Nimbus: screenshot picker" { spawn "qs" "-p" "/path/to/nimbus/shell.qml" "ipc" "call" "shortcut" "trigger" "screenshot"; }
    Mod+Ctrl+S       hotkey-overlay-title="Nimbus: screenshot to clipboard" { spawn "qs" "-p" "/path/to/nimbus/shell.qml" "ipc" "call" "shortcut" "trigger" "screenshotClip"; }
    Mod+B            hotkey-overlay-title="Open the default browser"  { spawn-sh "gtk-launch \"$(xdg-settings get default-web-browser)\""; }
    Mod+E            hotkey-overlay-title="Open Thunar"               { spawn "thunar"; }
    Super+Alt+L      hotkey-overlay-title="Nimbus: lock"              { spawn "qs" "-p" "/path/to/nimbus/shell.qml" "ipc" "call" "shortcut" "trigger" "lock"; }
}

// Translucent apps (see "App opacity" in niri.md): blur behind them, rounded corners, and draw the focus ring as an
// outline only.
// Without draw-border-with-background false, niri paints a solid block behind the focused window, so translucent
// windows only look translucent while unfocused.
window-rule {
    draw-border-with-background false

    // Rounded window corners (clip so the content, not just the border, follows the radius)
    geometry-corner-radius 12
    clip-to-geometry true

    background-effect {
        blur true
    }
}

// Optional: focus the window under the mouse (only windows already fully on screen, so the view never scrolls).
input {
    focus-follows-mouse max-scroll-amount="0%"
}

// Optional: open the overview from the top-right corner instead of niri's default top-left.
gestures {
    hot-corners {
        top-right
    }
}

// The settings window (Nexus) opens floating and focused instead of as a new tiled column.
window-rule {
    match app-id=r#"^org\.quickshell$"# title=r#"^Nexus"#
    open-floating true
    open-focused true
}
